# Supabase > Project Settings > Database > Connection string
# Use the transaction pooler (port 6543) for DATABASE_URL on serverless hosting.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Use the direct connection (port 5432) for Prisma schema push/deploys. If IPv6 connectivity is unavailable, use Supabase's session pooler.
DIRECT_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Firebase Console > Project settings > General
FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# Server-only Firebase Admin service-account key; keep the surrounding quotes and never expose it to NEXT_PUBLIC variables.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Generate a random secret with at least 32 characters before deployment.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_SUPPORT_URL="https://t.me/your_support_account"

# Optional default delivery fee, in ETB
DEFAULT_DELIVERY_FEE="0"
# Payment account details: configure only after verifying account ownership.
PAYMENT_TELEBIRR_ACCOUNT_NAME="Nova Campus Marketplace"
PAYMENT_TELEBIRR_NUMBER=""
PAYMENT_CBE_ACCOUNT_NAME="Nova Campus Marketplace"
PAYMENT_CBE_ACCOUNT_NUMBER=""
PAYMENT_BOA_ACCOUNT_NAME="Nova Campus Marketplace"
PAYMENT_BOA_ACCOUNT_NUMBER=""

# Cloudflare R2 object storage
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="nova-campus-public"\nR2_PRIVATE_BUCKET_NAME="nova-campus-private"
# Public custom domain for product images, e.g. https://images.example.com
R2_PUBLIC_BASE_URL="https://your-r2-public-domain"
