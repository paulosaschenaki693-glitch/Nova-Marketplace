generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  MERCHANT
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SOLD
  ARCHIVED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum PaymentMethod {
  TELEBIRR
  CBE
  BOA
}

enum PaymentStatus {
  NOT_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REFUNDED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum FulfillmentStatus {
  WAITING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  DISPUTED
  WAIVED
}

enum NotificationType {
  ORDER
  PAYMENT
  LISTING
  ACCOUNT
  SYSTEM
}

model User {
  id String @id @default(cuid())
  role Role
  status AccountStatus @default(PENDING)
  fullName String?
  shopName String?
  email String? @unique
  phone String
  studentIdNo String? @unique
  studentIdImageUrl String?
  passwordHash String?
  preferredLanguage String @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviewedAt DateTime?
  reviewedById String?
  reviewNote String?
  products Product[]
  buyerOrders Order[] @relation("BuyerOrders")
  sellerItems OrderItem[] @relation("ItemSeller")
  notifications Notification[]
  favorites Favorite[]
  reports Report[] @relation("Reporter")
  commissionEntries CommissionLedger[]
  auditLogs AdminAuditLog[]
  @@index([role, status])
}

model Category {
  id String @id @default(cuid())
  nameEn String
  nameAm String
  slug String @unique
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  products Product[]
  createdAt DateTime @default(now())
}

model Product {
  id String @id @default(cuid())
  sellerId String
  categoryId String
  title String
  description String
  price Decimal @db.Decimal(12,2)
  quantity Int @default(1)
  condition ProductCondition @default(GOOD)
  locationText String?
  status ListingStatus @default(PENDING_REVIEW)
  moderationNote String?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller User @relation(fields:[sellerId], references:[id])
  category Category @relation(fields:[categoryId], references:[id])
  images ProductImage[]
  orderItems OrderItem[]
  favorites Favorite[]
  reports Report[]
  @@index([status, categoryId, createdAt])
  @@index([title])
}

model ProductImage {
  id String @id @default(cuid())
  productId String
  imageUrl String
  storageKey String?
  sortOrder Int @default(0)
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
}

model Favorite {
  userId String
  productId String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  @@id([userId, productId])
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  buyerId String
  status OrderStatus @default(AWAITING_PAYMENT)
  subtotal Decimal @db.Decimal(12,2)
  deliveryFee Decimal @default(0) @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  currency String @default("ETB")
  fullName String
  phone String
  deliveryAddress String
  deliveryNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  buyer User @relation("BuyerOrders", fields:[buyerId], references:[id])
  items OrderItem[]
  payment Payment?
  fulfillments SellerFulfillment[]
  statusHistory OrderStatusHistory[]
  commissionLedger CommissionLedger[]
  @@index([buyerId, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  sellerId String
  titleSnapshot String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  commissionRate Decimal @db.Decimal(5,2)
  commissionAmount Decimal @db.Decimal(12,2)
  sellerNetAmount Decimal @db.Decimal(12,2)
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id])
  seller User @relation("ItemSeller", fields:[sellerId], references:[id])
  fulfillmentItem FulfillmentItem?
  @@index([orderId, sellerId])
}

model Payment {
  id String @id @default(cuid())
  orderId String @unique
  method PaymentMethod?
  amount Decimal @db.Decimal(12,2)
  screenshotUrl String?
  transactionReference String?
  status PaymentStatus @default(NOT_SUBMITTED)
  adminNote String?
  reviewedById String?
  submittedAt DateTime?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  @@index([status, createdAt])
}

model SellerFulfillment {
  id String @id @default(cuid())
  orderId String
  sellerId String
  status FulfillmentStatus @default(WAITING)
  assignedStaffId String?
  staffNotes String?
  pickupAt DateTime?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  items FulfillmentItem[]
  @@unique([orderId, sellerId])
  @@index([status, createdAt])
}

model FulfillmentItem {
  fulfillmentId String
  orderItemId String @unique
  fulfillment SellerFulfillment @relation(fields:[fulfillmentId], references:[id], onDelete:Cascade)
  orderItem OrderItem @relation(fields:[orderItemId], references:[id], onDelete:Cascade)
  @@id([fulfillmentId, orderItemId])
}

model CommissionLedger {
  id String @id @default(cuid())
  orderId String
  sellerId String
  grossAmount Decimal @db.Decimal(12,2)
  commissionRate Decimal @db.Decimal(5,2)
  amountDue Decimal @db.Decimal(12,2)
  amountPaid Decimal @default(0) @db.Decimal(12,2)
  status CommissionStatus @default(PENDING)
  adminNote String?
  settledAt DateTime?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId], references:[id])
  seller User @relation(fields:[sellerId], references:[id])
  @@index([sellerId, status])
}

model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  status String
  note String?
  changedById String?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
}

model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType @default(SYSTEM)
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, readAt, createdAt])
}

model Report {
  id String @id @default(cuid())
  reporterId String
  productId String?
  reportedUserId String?
  reason String
  details String?
  status String @default("OPEN")
  adminNote String?
  createdAt DateTime @default(now())
  reporter User @relation("Reporter", fields:[reporterId], references:[id])
  product Product? @relation(fields:[productId], references:[id])
}

model AdminAuditLog {
  id String @id @default(cuid())
  adminId String
  action String
  entityType String
  entityId String
  reason String?
  createdAt DateTime @default(now())
  admin User @relation(fields:[adminId], references:[id])
  @@index([entityType, entityId, createdAt])
}
